# Mova mobile client environment variables.
# Copy to `.env.local` (gitignored) and override per-environment.
# These are bundled into the client — DO NOT put secrets here.
#
# ── How URLs resolve on a phone vs. emulator vs. simulator ─────────────────
# On a real device running Expo Go, `localhost` resolves to the *phone*,
# not your dev machine. By default we auto-detect Metro's LAN IP and
# rewrite `localhost` → `192.168.X.Y` so the defaults below "just work".
# If you set a real hostname here (e.g. https://api.mova.app/v1) we never
# touch it. Override either var if you need to pin a specific IP.

# REST API base — must include the /v1 prefix. Backend default is :3000.
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# Realtime Socket.IO gateway. Backend default is :3002 — mobile namespaces
# to `/calls`. Don't use :3001 — that's the internal agent-worker port,
# not the one the realtime service binds to.
EXPO_PUBLIC_WS_URL=ws://localhost:3002

# Sentry DSN. Leave blank in development; required in staging / production.
EXPO_PUBLIC_SENTRY_DSN=

# Google OAuth client ids (from Google Cloud Console → Credentials).
# Leave blank to hide the "Sign in with Google" button — without the
# platform's id, expo-auth-session can't build a request. Set the id(s)
# for the platforms you ship: web for Expo web, android for the Android
# build, ios for the iOS build.
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=
